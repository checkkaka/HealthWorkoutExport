+//! Pure fail-closed policy for the separately audited offline generator.
+use std::path::PathBuf;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CommandKind {
+    Expand,
+    Metadata,
+}
+
+pub(crate) fn classify_command(program: &str, args: &[PathBuf]) -> Result<CommandKind, String> {
+    let strings = args
+        .iter()
+        .map(|x| x.to_str().ok_or("non-UTF8 command argument".to_owned()))
+        .collect::<Result<Vec<_>, _>>()?;
+    if program != "cargo" {
+        return Err(format!("offline policy rejects executable {program}"));
+    }
+    if strings.len() == 7
+        && strings[..4] == ["metadata", "--format-version", "1", "--manifest-path"]
+        && PathBuf::from(strings[4]).is_absolute()
+        && strings[5..] == ["--offline", "--locked"]
+    {
+        return Ok(CommandKind::Metadata);
+    }
+    if strings.len() >= 4 && strings[..4] == ["expand", "--lib", "--theme=none", "--ugly"] {
+        let extra = &strings[4..];
+        if extra.len() % 2 != 0 {
+            return Err("incomplete expansion option".to_owned());
+        }
+        let mut package_seen = false;
+        for pair in extra.chunks_exact(2) {
+            let valid_value =
+                !pair[1].is_empty() && !pair[1].starts_with('-') && !pair[1].starts_with('+');
+            match pair[0] {
+                "-p" if valid_value && !package_seen => package_seen = true,
+                "--features" if valid_value => (),
+                _ => return Err("unsupported expansion option".to_owned()),
+            }
+        }
+        return Ok(CommandKind::Expand);
+    }
+    Err("offline policy rejects unsupported Cargo command".to_owned())
+}
+
+pub(crate) fn reject_enabled(name: &str, enabled: bool) -> Result<(), String> {
+    if enabled {
+        Err(format!("offline generation does not support {name}"))
+    } else {
+        Ok(())
+    }
+}
+
+pub(crate) fn validate_output(freezed: bool, json: bool) -> Result<(), String> {
+    reject_enabled("Freezed output requiring Dart build_runner", freezed)?;
+    reject_enabled(
+        "JSON serialization output requiring Dart code generation",
+        json,
+    )
+}
