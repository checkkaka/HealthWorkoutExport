+//! Offline-only execution adapter. Never starts Dart, Flutter, FVM or installers.
+use crate::codegen::{Config, MetaConfig};
+use crate::offline_policy::{classify_command, reject_enabled, CommandKind};
+use anyhow::{bail, ensure, Context, Result};
+use sha2::{Digest, Sha256};
+use std::{
+    env, fs,
+    path::{Path, PathBuf},
+    process::Command,
+};
+
+#[derive(Debug)]
+struct PinnedTools {
+    cargo: PathBuf,
+    expand: PathBuf,
+    rustc: PathBuf,
+    cargo_home: PathBuf,
+}
+
+fn verify_pin(path: &Path, expected: &str) -> Result<()> {
+    ensure!(
+        path.is_absolute(),
+        "offline executable path must be absolute"
+    );
+    ensure!(
+        fs::canonicalize(path)? == path,
+        "offline executable path must be canonical (no proxy or symlink)"
+    );
+    ensure!(path.is_file(), "offline executable must be a regular file");
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        ensure!(
+            fs::metadata(path)?.permissions().mode() & 0o111 != 0,
+            "offline executable is not executable"
+        );
+    }
+    ensure!(
+        expected.len() == 64 && expected.bytes().all(|x| x.is_ascii_hexdigit()),
+        "offline executable SHA256 pin must be 64 hex characters"
+    );
+    let actual = hex::encode(&Sha256::digest(fs::read(path)?)[..]);
+    ensure!(
+        actual.eq_ignore_ascii_case(expected),
+        "offline executable SHA256 mismatch: {}",
+        path.display()
+    );
+    Ok(())
+}
+
+fn pinned_tool(name: &str) -> Result<PathBuf> {
+    let path = PathBuf::from(env::var(name).with_context(|| format!("missing {name}"))?);
+    let expected =
+        env::var(format!("{name}_SHA256")).with_context(|| format!("missing {name}_SHA256"))?;
+    verify_pin(&path, &expected)?;
+    Ok(path)
+}
+
+fn reject_cargo_configuration(start: &Path, cargo_home: &Path) -> Result<()> {
+    for name in ["config", "config.toml"] {
+        ensure!(
+            !cargo_home.join(name).exists(),
+            "offline adapter requires a Cargo home without configuration overrides"
+        );
+        for ancestor in start.ancestors() {
+            ensure!(
+                !ancestor.join(".cargo").join(name).exists(),
+                "offline adapter rejects ancestor Cargo configuration: {}",
+                ancestor.display()
+            );
+        }
+    }
+    Ok(())
+}
+
+impl PinnedTools {
+    fn load() -> Result<Self> {
+        let cargo = pinned_tool("FRB_OFFLINE_CARGO")?;
+        let expand = pinned_tool("FRB_OFFLINE_CARGO_EXPAND")?;
+        let rustc = pinned_tool("FRB_OFFLINE_RUSTC")?;
+        let cargo_home =
+            PathBuf::from(env::var("CARGO_HOME").context("offline adapter requires CARGO_HOME")?);
+        ensure!(
+            cargo_home.is_absolute() && cargo_home.is_dir(),
+            "CARGO_HOME must be an existing absolute directory"
+        );
+        for key in [
+            "RUSTFLAGS",
+            "CARGO_ENCODED_RUSTFLAGS",
+            "RUSTC_WRAPPER",
+            "RUSTC_WORKSPACE_WRAPPER",
+            "CARGO_BUILD_RUSTC_WRAPPER",
+            "CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER",
+        ] {
+            ensure!(
+                env::var_os(key).is_none_or(|v| v.is_empty()),
+                "offline adapter rejects inherited {key}"
+            );
+        }
+        Ok(Self {
+            cargo,
+            expand,
+            rustc,
+            cargo_home,
+        })
+    }
+}
+
+/// Called before config resolution (which performs metadata and creates paths).
+pub(crate) fn prepare_config(mut config: Config, meta: &MetaConfig) -> Result<Config> {
+    validate_config(&mut config, meta)?;
+    let tools = PinnedTools::load()?;
+    reject_cargo_configuration(&env::current_dir()?, &tools.cargo_home)?;
+    Ok(config)
+}
+
+fn validate_config(config: &mut Config, meta: &MetaConfig) -> Result<()> {
+    let switches = [
+        ("full_dep / ffigen", config.full_dep),
+        ("build_runner", config.build_runner),
+        ("dart_fix", config.dart_fix),
+        ("dart_format", config.dart_format),
+        ("rust_format", config.rust_format),
+        ("auto_upgrade_dependency", config.auto_upgrade_dependency),
+        ("add_mod_to_lib", config.add_mod_to_lib),
+        ("dump_all", config.dump_all),
+    ];
+    for (name, value) in switches {
+        reject_enabled(name, value.unwrap_or(false)).map_err(anyhow::Error::msg)?;
+    }
+    reject_enabled("watch", meta.watch).map_err(anyhow::Error::msg)?;
+    ensure!(
+        config.dump.as_ref().is_none_or(|x| x.is_empty()),
+        "offline adapter rejects dump output"
+    );
+    ensure!(
+        config.c_output.is_none()
+            && config
+                .duplicated_c_output
+                .as_ref()
+                .is_none_or(|x| x.is_empty()),
+        "offline adapter rejects C output requiring full_dep"
+    );
+    ensure!(
+        config.stop_on_error != Some(false),
+        "offline adapter requires stop_on_error"
+    );
+    config.full_dep = Some(false);
+    config.build_runner = Some(false);
+    config.dart_fix = Some(false);
+    config.dart_format = Some(false);
+    config.rust_format = Some(false);
+    config.auto_upgrade_dependency = Some(false);
+    config.add_mod_to_lib = Some(false);
+    config.stop_on_error = Some(true);
+    Ok(())
+}
+
+/// The only process construction path permitted by the offline generation entry.
+pub(crate) fn command(
+    program: &str,
+    args: &[PathBuf],
+    current_dir: Option<&Path>,
+) -> Result<Command> {
+    let kind = classify_command(program, args).map_err(anyhow::Error::msg)?;
+    let tools = PinnedTools::load()?;
+    let cwd = current_dir
+        .map(PathBuf::from)
+        .unwrap_or(env::current_dir()?);
+    reject_cargo_configuration(&cwd, &tools.cargo_home)?;
+    command_with_tools(kind, args, &cwd, tools)
+}
+
+fn command_with_tools(
+    kind: CommandKind,
+    args: &[PathBuf],
+    cwd: &Path,
+    tools: PinnedTools,
+) -> Result<Command> {
+    let executable = match kind {
+        CommandKind::Expand => &tools.expand,
+        CommandKind::Metadata => &tools.cargo,
+    };
+    let mut command = Command::new(executable);
+    command.env_clear();
+    for name in ["HOME", "TMPDIR", "TMP", "TEMP"] {
+        if let Some(value) = env::var_os(name) {
+            command.env(name, value);
+        }
+    }
+    let search_path = env::join_paths([
+        tools.rustc.parent().context("rustc has no parent")?,
+        tools.cargo.parent().context("cargo has no parent")?,
+        Path::new("/usr/bin"),
+        Path::new("/bin"),
+    ])?;
+    command
+        .env("PATH", search_path)
+        .env("CARGO_HOME", tools.cargo_home)
+        .env("CARGO_NET_OFFLINE", "true")
+        .env("CARGO_TERM_COLOR", "never")
+        .env("CARGO", tools.cargo)
+        .env("RUSTC", tools.rustc);
+    command.current_dir(cwd).args(args);
+    if kind == CommandKind::Expand {
+        // cargo-expand forwards these Cargo flags and otherwise may update Cargo.lock.
+        command
+            .arg("--offline")
+            .arg("--locked")
+            .arg("--color=never");
+    }
+    Ok(command)
+}
+
+pub(crate) fn check_extra_environment(
+    envs: &std::collections::HashMap<String, String>,
+) -> Result<()> {
+    for (key, value) in envs {
+        if key != "RUSTFLAGS" || value != "--cfg frb_expand" {
+            bail!("offline adapter rejects subprocess environment override {key}");
+        }
+    }
+    Ok(())
+}
